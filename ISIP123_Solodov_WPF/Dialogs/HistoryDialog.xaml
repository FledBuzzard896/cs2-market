<Window x:Class="ISIP123_Solodov_WPF.Dialogs.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="HistoryDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Шапка таблицы -->
        <Grid Margin="18,10,18,5" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource DialogHeaderText}" Grid.Column="1"/>
            <TextBlock Text="РАЗМЕЩЕНО" Style="{StaticResource DialogHeaderTextCenter}" Grid.Column="2"/>
            <TextBlock Text="ДАТА СДЕЛКИ" Style="{StaticResource DialogHeaderTextCenter}" Grid.Column="3"/>
            <TextBlock Text="ЦЕНА" Style="{StaticResource DialogHeaderTextCenter}" Grid.Column="4"/>
        </Grid>

        <!-- Список истории -->
        <ListBox x:Name="MarketHistoryLB" 
             Style="{StaticResource DialogListBox}" 
             ItemContainerStyle="{StaticResource DialogListBoxItem}"
             Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource DialogRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding OperationSign}" Style="{StaticResource DialogOperationSign}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ItemName}" Style="{StaticResource DialogItemTitle}" Grid.Column="1" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" Style="{StaticResource DialogItemText}" Grid.Column="2"/>
                            <TextBlock Text="{Binding SoldAt, StringFormat='{}{0:dd.MM.yyyy}'}" Style="{StaticResource DialogItemText}" Grid.Column="3"/>
                            <TextBlock Text="{Binding Price, StringFormat={}{0} ₽}" Style="{StaticResource DialogItemPrice}" Grid.Column="4"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
