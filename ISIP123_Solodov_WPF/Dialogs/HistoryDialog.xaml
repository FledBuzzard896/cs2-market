<Window x:Class="ISIP123_Solodov_WPF.Dialogs.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="HistoryDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="#181a21">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid Margin="18,10,18,5" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="НАЗВАНИЕ" FontSize="14" Grid.Column="1" Foreground="#afb1b8"/>
            <TextBlock Text="РАЗМЕЩЕНО" FontSize="14" Grid.Column="2" Foreground="#afb1b8" HorizontalAlignment="Center"/>
            <TextBlock Text="ДАТА СДЕЛКИ" FontSize="14" Grid.Column="3" Foreground="#afb1b8" HorizontalAlignment="Center"/>
            <TextBlock Text="ЦЕНА" FontSize="14" Grid.Column="4" Foreground="#afb1b8" HorizontalAlignment="Center"/>
        </Grid>
        <ListBox x:Name="MarketHistoryLB" Margin="10" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#16202d" CornerRadius="4" Margin="0,0,0,6" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding OperationSign}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#577c22" Grid.Column="0"/>
                            <TextBlock Text="{Binding Transaction.Inventories.Items.Name}" FontSize="14" FontWeight="Bold" Foreground="#66c0f4" VerticalAlignment="Center" Grid.Column="1"/>
                            <TextBlock Text="{Binding Transaction.DateOfCreatingOffer, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" Foreground="#afb1b8" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
                            <TextBlock Text="{Binding Transaction.DateOfDeal, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="14" Foreground="#afb1b8" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="3"/>
                            <TextBlock Text="{Binding Transaction.Price, StringFormat={}{0} ₽}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="4"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
