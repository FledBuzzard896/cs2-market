<Window x:Class="ISIP123_Solodov_WPF.Dialogs.Error"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="Error 404" Height="400" Width="600"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/stem-logo-nobg.png" 
           Style="{StaticResource ErrorLogo}" 
           Grid.Row="0" />

        <Image Source="/Images/bummer.png" Grid.Row="1"/>

        <StackPanel Orientation="Vertical" Grid.Row="2">
            <TextBlock Text="Что-то Пошло Не Так" Style="{StaticResource ErrorTitle}"/>
            <TextBlock Text="Мы не смогли обработать ваш запрос. Пожалуйста, повторите попытку позже." Style="{StaticResource ErrorSubtitle}"/>
        </StackPanel>

        <Button Content="Закрыть окно" 
            Style="{StaticResource ErrorCloseButton}" 
            Grid.Row="3" 
            Click="Button_Click"/>
    </Grid>
</Window>
