<Window x:Class="ISIP123_Solodov_WPF.Dialogs.RegistrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="RegistrationDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Image Source="/Images/stem-logo-nobg.png" Style="{StaticResource LogoStemAuthPage}" Margin="5" Grid.Row="0"/>

        <TextBlock Text="СОЗДАНИЕ АККАУНТА" Style="{StaticResource RegistrationTitle}" Grid.Row="1" Grid.Column="1"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Логин" Style="{StaticResource RegistrationLabel}"/>
            <TextBox x:Name="NewUserLoginTB" Style="{StaticResource RegistrationTextBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Пароль" Style="{StaticResource RegistrationLabel}"/>
            <PasswordBox x:Name="NewUserPasswordF" Style="{StaticResource RegistrationPasswordBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Повторите пароль" Style="{StaticResource RegistrationLabel}"/>
            <PasswordBox x:Name="NewUserPasswordS" Style="{StaticResource RegistrationPasswordBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,20">
            <TextBlock Text="Никнейм" Style="{StaticResource RegistrationLabel}"/>
            <TextBox x:Name="NickNameTB" Style="{StaticResource RegistrationTextBox}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1">
            <Button x:Name="BackBtn" Content="Назад" Style="{StaticResource RegistrationButton}" Margin="0,0,50,0" Click="BackBtn_Click"/>
            <Button x:Name="RegBtn" Content="Создать" Style="{StaticResource RegistrationButton}" Click="RegBtn_Click"/>
        </StackPanel>

        <Image Source="/Images/TheGreatGaben.jpg" Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Margin="0,0,10,0"/>
    </Grid>
</Window>
