<Window x:Class="ISIP123_Solodov_WPF.Dialogs.LastQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="LastQuestion" Height="400" Width="600"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource LastQuestionBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/stem-logo-nobg.png" Style="{StaticResource LastQuestionLogo}" Grid.Row="0"/>
        <Image Source="/Images/lastquestion.jpg" Grid.Row="1" Grid.RowSpan="3" Stretch="Fill"/>
        <TextBlock Text="Вы уверены, что хотите закрыть окно?" Style="{StaticResource LastQuestionTitle}" Grid.Row="1"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="YesBtn" Content="Да" Style="{StaticResource LastQuestionButton}" Click="YesBtn_Click"/>
            <Button x:Name="NoBtn" Content="Нет" Style="{StaticResource LastQuestionButton}" Margin="100,0,0,0" Click="NoBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
