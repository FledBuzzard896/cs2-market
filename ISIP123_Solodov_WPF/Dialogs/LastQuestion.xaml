<Window x:Class="ISIP123_Solodov_WPF.Dialogs.LastQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="LastQuestion" Height="400" Width="600"
        MinHeight="400" MinWidth="600"
        MaxHeight="400" MaxWidth="600">
    <Grid Background="#262626">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Image Source="/Images/stem-logo-nobg.png" Width="100" Grid.Row="0" HorizontalAlignment="Right" Margin="10"/>
        <TextBlock Text="Вы уверены, что хотите закрыть окно?" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" Grid.Row="1"/>
        <Image Source="/Images/lastquestion.jpg" Grid.Row="2" Stretch="Fill"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="YesBtn" Content="Да" BorderThickness="0" Width="75" Background="#5076a3" Foreground="White" Click="YesBtn_Click"/>
            <Button x:Name="NoBtn" Content="Нет" BorderThickness="0" Width="75" Background="#5076a3" Foreground="White" Margin="100,0,0,0" Click="NoBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
