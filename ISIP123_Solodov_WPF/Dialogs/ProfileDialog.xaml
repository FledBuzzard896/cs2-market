<Window x:Class="ISIP123_Solodov_WPF.Dialogs.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="ProfileDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Логин: " Style="{StaticResource ProfileLabelText}"/>
            <TextBlock x:Name="LoginTBox" Style="{StaticResource ProfileValueText}" Grid.Column="1"/>

            <TextBlock Text="Никнейм: " Style="{StaticResource ProfileLabelText}" Grid.Row="1"/>
            <TextBlock x:Name="NicknameTBox" Style="{StaticResource ProfileValueText}" Grid.Row="1" Grid.Column="1"/>

            <TextBlock Text="Баланс: " Style="{StaticResource ProfileLabelText}" Grid.Row="2"/>
            <TextBlock x:Name="BalanceTBox" Style="{StaticResource ProfileValueText}" Grid.Row="2" Grid.Column="1"/>

            <Button x:Name="TopUpBalance" Content="Пополнить" Style="{StaticResource ProfileActionButton}" Grid.Row="3" Grid.ColumnSpan="2" Click="TopUpBalance_Click"/>

            <!-- Кнопка смены темы -->
            <!-- <Button x:Name="SwitchThemeBtn" Content="Сменить тему" Style="{StaticResource ProfileActionButton}" Grid.Row="4" Grid.ColumnSpan="2" Background="#1999ff" Click="SwitchThemeBtn_Click"/> -->
        </Grid>
    </Grid>
</Window>
