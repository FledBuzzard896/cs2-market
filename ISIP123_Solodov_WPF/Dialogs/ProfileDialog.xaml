<Window x:Class="ISIP123_Solodov_WPF.Dialogs.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="ProfileDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="#181a21">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Логин: " FontSize="16" Foreground="#afb1b8" Margin="0,0,0,10"/>
            <TextBlock x:Name="LoginTBox" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Right"/>
            <TextBlock Text="Никнейм: " FontSize="16" Foreground="#afb1b8" Grid.Row="1" Margin="0,0,0,10"/>
            <TextBlock x:Name="NicknameTBox" FontSize="16" Foreground="#afb1b8" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Right"/>
            <TextBlock Text="Банланс" FontSize="16" Foreground="#afb1b8" Grid.Row="2" Margin="0,0,0,10"/>
            <TextBlock x:Name="BalanceTBox" FontSize="16" Foreground="#afb1b8" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Right"/>
            <Button x:Name="TopUpBalance" Content="Пополнить" Width="100" Height="25" Grid.Row="3" Margin="10" Grid.ColumnSpan="2" BorderThickness="0" Background="#1999ff" Foreground="White" Click="TopUpBalance_Click"/>
        </Grid>
    </Grid>
</Window>
