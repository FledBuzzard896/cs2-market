<Window x:Class="ISIP123_Solodov_WPF.Dialogs.TransactionConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="TransactionConfirmation" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="#181a21">
        <Grid x:Name="MainGrid" Margin="20,15,10,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Купить предмет" Foreground="White" FontSize="20" FontWeight="Bold"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="НАЗВАНИЕ" FontSize="14" Foreground="#afb1b8" Margin="10,0,0,10" Grid.Column="0"/>
                <TextBlock Text="ЦЕНА" FontSize="14" Foreground="#afb1b8" Margin="0,0,0,10" HorizontalAlignment="Center" Grid.Column="1"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource ImageFrame}"  Width="50" Height="50" Margin="10,0,10,0">
                        <Image Source="{Binding Inventories.Items.ItemPicture}"/>
                    </Border>
                    <TextBlock Text="{Binding Inventories.Items.Name}" FontSize="16" Foreground="#1999ff" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Price" Text="тест" FontSize="16" Foreground="White" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="2" Margin="10,10,0,10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Промежуточный итог:" FontSize="14" Foreground="#afb1b8" HorizontalAlignment="Right" Grid.Column="0"/>
                <TextBlock x:Name="Price_2" Text="тест" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
                <TextBlock Text="Комиссия Stem, взимается Valve Corporation:" FontSize="14" Foreground="#afb1b8"  HorizontalAlignment="Right" Margin="0,5,0,0" Grid.Column="0" Grid.Row="1"/>
                <TextBlock Text="{Binding Commission, StringFormat={}{0} руб.}" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Grid.Row="1"/>
                <Separator Background="#afb1b8" Height="1" Margin="0,10,10,10" Grid.ColumnSpan="3" Grid.Row="2"/>
                <TextBlock Text="Итого:" FontSize="14" Foreground="#afb1b8" HorizontalAlignment="Right" Grid.Column="0" Grid.Row="3"/>
                <TextBlock x:Name="TotalSum" FontSize="14" Foreground="#afb1b8" Grid.Column="2" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Способ оплаты:" FontSize="14" Foreground="#afb1b8" Margin="10,15,0,0"  Grid.Row="0"/>
                <TextBlock Text="Мой кошелёк Stem" FontSize="14" Foreground="#577c22" Margin="0,15,0,0" Grid.Row="0" Grid.Column="2"/>
                <TextBlock Text="Аккаунт Stem:" FontSize="14" Foreground="#afb1b8" Margin="10,5,0,0" Grid.Row="1"/>
                <TextBlock x:Name="LoginTextBlock" FontSize="14" Foreground="#afb1b8" Margin="0,5,0,0" Grid.Row="1" Grid.Column="2"/>
            </Grid>
            <CheckBox x:Name="SSA" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Margin="10,15,0,0" Grid.Row="4">
                <CheckBox.Content>
                    <TextBlock>
                        Я принимаю
                        <Hyperlink NavigateUri="https://store.steampowered.com/subscriber_agreement/russian/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="White">
                            Соглашение подписчика Stem
                        </Hyperlink>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>
            <Button Content="Купить" Foreground="White" Background="#577c22" BorderThickness="0" Width="75" Height="20" Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Click="Button_Click"/>
        </Grid>
    </Grid>
</Window>
