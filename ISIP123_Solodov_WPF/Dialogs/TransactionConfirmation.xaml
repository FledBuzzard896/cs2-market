<Window x:Class="ISIP123_Solodov_WPF.Dialogs.TransactionConfirmation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="TransactionConfirmation" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid x:Name="MainGrid" Margin="20,15,10,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Покупка предметов" Style="{StaticResource BuyDialogTitle}"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource DialogHeaderText}" Margin="10,0,0,10" Grid.Column="0"/>
                <TextBlock Text="СУММА" Style="{StaticResource DialogHeaderTextCenter}" Margin="0,0,0,10" Grid.Column="1"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource ImageFrame}" Width="50" Height="50" Margin="10,0,10,0">
                        <Image x:Name="ItemImage" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="ItemName" Style="{StaticResource BuyDialogItemName}"/>
                </StackPanel>

                <TextBlock x:Name="Price" Text="0 руб." Style="{StaticResource BuyDialogItemPrice}" Grid.Row="2" Grid.Column="1"/>
            </Grid>

            <Grid Grid.Row="2" Margin="10,10,0,10" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Промежуточный итог:" Style="{StaticResource BuyDialogSummaryLabel}" Grid.Column="0"/>
                <TextBlock x:Name="Price_2" Text="0 руб." Style="{StaticResource BuyDialogSummaryValue}" Grid.Column="2"/>

                <TextBlock Text="Комиссия Stem, взимается Valve Corporetion:" Style="{StaticResource BuyDialogSummaryLabel}" Margin="0,5,0,0" Grid.Column="0" Grid.Row="1"/>
                <TextBlock x:Name="CommissionText" Text="0 руб." Style="{StaticResource BuyDialogSummaryValue}" Grid.Column="2" Grid.Row="1"/>

                <Separator Style="{StaticResource DialogSeparator}" Margin="0,10,10,10" Grid.ColumnSpan="3" Grid.Row="2"/>

                <TextBlock Text="Итого:" Style="{StaticResource BuyDialogSummaryLabel}" Grid.Column="0" Grid.Row="3"/>
                <TextBlock x:Name="TotalSum" Style="{StaticResource BuyDialogSummaryFinal}" Grid.Column="2" Grid.Row="3"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Способ оплаты:" Style="{StaticResource BuyDialogPaymentLabel}" Margin="10,15,0,0" Grid.Row="0"/>
                <TextBlock Text="Мой кошелёк Stem" Style="{StaticResource BuyDialogPaymentValueGreen}" Margin="0,15,0,0" Grid.Row="0" Grid.Column="2"/>

                <TextBlock Text="Аккаунт Stem:" Style="{StaticResource BuyDialogPaymentLabel}" Margin="10,5,0,0" Grid.Row="1"/>
                <TextBlock x:Name="LoginTextBlock" Style="{StaticResource BuyDialogPaymentValue}" Margin="0,5,0,0" Grid.Row="1" Grid.Column="2"/>
            </Grid>

            <CheckBox x:Name="SSA" Style="{StaticResource BuyDialogAgreement}" Grid.Row="4">
                <CheckBox.Content>
                    <TextBlock>
                Я принимаю
                <Hyperlink NavigateUri="https://store.steampowered.com/subscriber_agreement/russian/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="White">
                    Соглашение подписчика Stem
                </Hyperlink>
                    </TextBlock>
                </CheckBox.Content>
            </CheckBox>

            <Button Content="Купить" Style="{StaticResource BuyDialogButton}" Grid.Row="5" Click="Button_Click"/>
        </Grid>
    </Grid>
</Window>
