<Window x:Class="ISIP123_Solodov_WPF.Dialogs.GabenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GabenDialog" 
        Height="450" Width="800" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="#181a21">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTBlock" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,20,0,20"/>

            <ListBox x:Name="MainListBox" Grid.Row="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ID}" Foreground="White" FontSize="20" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Login}" Foreground="White" FontSize="18" Grid.Column="1" VerticalAlignment="Center"/>

                            <ComboBox Grid.Column="3" 
                                      x:Name="ItemComboBox"
                                      ItemsSource="{Binding ItemsList, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name" 
                                      SelectionChanged="ItemComboBox_SelectionChanged"
                                      Tag="{Binding}"
                                      Width="150"
                                      Margin="10,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="GiveItem">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Button Grid.Column="3" 
                                    Content="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    Tag="{Binding}" 
                                    Click="ActionButton_Click"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    Background="#2a475e" Foreground="White" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="GiveItem">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>