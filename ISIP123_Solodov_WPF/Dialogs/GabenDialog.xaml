<Window x:Class="ISIP123_Solodov_WPF.Dialogs.GabenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GabenDialog"
        Height="450" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTBlock" Style="{StaticResource GabenDialogTitle}"/>

            <ListBox x:Name="MainListBox" Grid.Row="1"
                     Style="{StaticResource GabenMainListBox}"
                     ItemContainerStyle="{StaticResource GabenListBoxItem}">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding ID}" Grid.Column="0"
                                       Style="{StaticResource GabenUserIdText}"/>
                            <TextBlock Text="{Binding Login}" Grid.Column="1"
                                       Style="{StaticResource GabenUserLoginText}"/>

                            <ComboBox Grid.Column="3" x:Name="ItemComboBox"
                                ItemsSource="{Binding ItemsList, RelativeSource={RelativeSource AncestorType=Window}}"
                                DisplayMemberPath="Name"
                                SelectionChanged="ItemComboBox_SelectionChanged"
                                Tag="{Binding}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource GabenItemComboBox}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="GiveItem">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>

                            <Button Grid.Column="3"
                                Content="{Binding ButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                Tag="{Binding}"
                                Click="ActionButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GabenRowActionButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="GiveItem">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid x:Name="MarketStatistic" Grid.Row="1"
                  Style="{StaticResource GabenMarketStatisticPanel}"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="2" Style="{StaticResource GabenStatTopAccentLine}"/>

                <Border Grid.Row="0" Style="{StaticResource GabenStatSeparator}"/>
                <TextBlock Text="GMV (Оборот Торговой площадки)" Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource GabenStatLabel}"/>
                <TextBlock x:Name="GmvTBlock" Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource GabenStatValueAccent}"/>

                <Border Grid.Row="1" Style="{StaticResource GabenStatSeparator}"/>
                <TextBlock Text="Market Cap предметов" Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource GabenStatLabel}"/>
                <TextBlock x:Name="MarketCupTBlock" Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource GabenStatValue}"/>

                <TextBlock Text="Капитализация торговой площадки" Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource GabenStatLabel}"/>
                <TextBlock x:Name="MarketCapitalizationTBlock" Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource GabenStatValueGreen}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>