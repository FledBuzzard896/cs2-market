<Window x:Class="ISIP123_Solodov_WPF.Dialogs.SellDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Dialogs"
        mc:Ignorable="d"
        Title="SellDialog" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid Background="{StaticResource DialogBackground}">
        <Grid x:Name="MainGrid" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Выставление предмета на продажу" Style="{StaticResource SellDialogTitle}" Grid.Row="0"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource ImageFrame}" Width="100" Height="100" Margin="0,0,20,0" Grid.Row="0" Grid.Column="0">
                    <Image Source="{Binding Items.ItemPicture}"/>
                </Border>

                <TextBlock Text="{Binding Items.Name}" Style="{StaticResource SellDialogItemName}" Grid.Row="0" Grid.Column="1"/>

                <Separator Style="{StaticResource DialogSeparator}" Margin="0,10,0,20" Grid.ColumnSpan="2" Grid.Row="1"/>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock x:Name="AveragePrice" Style="{StaticResource SellDialogPriceText}" Margin="0,0,0,10"/>
                <TextBlock x:Name="LastUserPrice" Style="{StaticResource SellDialogPriceText}"/>
            </StackPanel>

            <Separator Style="{StaticResource DialogSeparator}" Grid.Row="3"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,15,0,0">
                <Button x:Name="MinusBtn" Content="-" Style="{StaticResource CountButton}" Click="MinusBtn_Click"/>
                <TextBlock x:Name="CountTBlock" Style="{StaticResource CountText}"/>
                <Button x:Name="PlusBtn" Content="+" Style="{StaticResource CountButton}" Click="PlusBtn_Click"/>
                <TextBlock x:Name="DescriptionTBlock" Text="(так как предмет является уникальным, продажа нескольких экземпляров невозможна)" Style="{StaticResource WarningText}" Visibility="Hidden"/>
            </StackPanel>

            <StackPanel Grid.Row="5" HorizontalAlignment="Center" Margin="10" Orientation="Horizontal">
                <TextBlock Text="Вы получите: " Style="{StaticResource PriceInputLabel}"/>
                <TextBox x:Name="SellerProfit" Style="{StaticResource PriceInputBox}" TextChanged="SellerProfit_TextChanged" PreviewTextInput="NumberTextBox_PreviewTextInput"/>

                <TextBlock Text="Покупатель заплатит: (за единицу) " Style="{StaticResource PriceInputLabel}" Margin="100,0,0,0"/>
                <TextBox x:Name="BuyerPays" Style="{StaticResource PriceInputBox}" TextChanged="BuyerPays_TextChanged" PreviewTextInput="NumberTextBox_PreviewTextInput"/>
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="SSA" Style="{StaticResource AgreementCheckBox}" Grid.Column="0">
                    <CheckBox.Content>
                        <TextBlock>
                    Я принимаю
                    <Hyperlink NavigateUri="https://store.steampowered.com/subscriber_agreement/russian/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="White">
                        Соглашение подписчика Stem
                    </Hyperlink>
                        </TextBlock>
                    </CheckBox.Content>
                </CheckBox>
                <Button x:Name="SellButton" Content="Да, выставить на продажу" Style="{StaticResource GreenActionButton}" Grid.Column="1" Click="SellButton_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
