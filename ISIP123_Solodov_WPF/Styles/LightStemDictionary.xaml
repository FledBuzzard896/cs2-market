<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Подключаем шрифт Open Sans (если он добавлен в проект) -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#Open Sans</FontFamily>

    <!-- === ОСНОВНЫЕ ЦВЕТА (из твоего стайлгайда) === -->
    <SolidColorBrush x:Key="DialogBackground" Color="#F3F3F3"/>
    <!-- Светло-серый фон (Pantone 649) -->
    <SolidColorBrush x:Key="HeaderBG" Color="#233E76"/>
    <!-- Темно-синий (Pantone 7687) -->
    <SolidColorBrush x:Key="MarketBG" Color="#0198AF"/>
    <!-- Бирюзовый (Pantone 7711) -->

    <!-- === СТИЛИ ДЛЯ ДИАЛОГОВ === -->
    <Style x:Key="DialogHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <!-- Темно-синий текст -->
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogHeaderTextCenter" TargetType="TextBlock" BasedOn="{StaticResource DialogHeaderText}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DialogListBox" TargetType="ListBox">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="DialogListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Строка в списке (Белая плашка) -->
    <Style x:Key="DialogRowBorder" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#eae8ed"/>
        <!-- Серый контур -->
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="DialogItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0198AF"/>
        <!-- Бирюзовый -->
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogItemText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Кнопки действий (зеленые/бирюзовые) -->
    <Style x:Key="DialogActionButton" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#0198AF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#46C6C5"/>
                <!-- Светло-бирюзовый при наведении -->
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- === СТИЛИ ДЛЯ МАРКЕТА И ИНВЕНТАРЯ === -->
    <Style x:Key="ExitBtn" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#233E76"/>
        <!-- Темно-синий -->
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="AccountTBox" TargetType="TextBlock">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="#0198AF"/>
        <Setter Property="Background" Value="#F3F3F3"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Карточки предметов в маркете -->
    <Style x:Key="OneListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#233E76"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#eae8ed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MainListBox" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="ItemName" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0198AF"/>
    </Style>

    <!-- Зеленые кнопки (Продать, Купить) -->
    <Style x:Key="GreenActionButton" TargetType="Button">
        <Setter Property="Background" Value="#0198AF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#46C6C5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>