<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ===== СТРАНИЦА ВХОДА В STEM ===== -->
    <!-- Стиль кнопок при первом входе в Stem -->
    <Style x:Key="FirstTimeStem" TargetType="Button">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="125"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#214b6b"/>
    </Style>
    <Style x:Key="EnterButton" TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="100,20,100,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#1999ff"/>
    </Style>
    
    <!-- Стиль полей для ввода при авторизации/регистрации -->
    <Style x:Key="AuthTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="AuthPassBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="PasswordChar" Value="•"/>
    </Style>
    
    <!-- Стиль границы области информации о входе -->
    <Style x:Key="GrayBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#32353c"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- Стиль плашки "Первый раз в Stem?" -->
    <Style x:Key="FirstTimeStemTBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Стиль лого Stem на странице авторизации/регистрации -->
    <Style x:Key="LogoStemAuthPage" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
</ResourceDictionary>