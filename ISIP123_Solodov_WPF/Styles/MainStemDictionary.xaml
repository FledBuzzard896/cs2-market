    <!-- Карточка предмета (справа) -->
    <Style x:Key="InventoryCardBorder" TargetType="Border">
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#66c0f4"/>
        <Setter Property="Margin" Value="10,0,5,5"/>
