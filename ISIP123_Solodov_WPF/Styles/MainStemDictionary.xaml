<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== СТИЛИ ДЛЯ ДИАЛОГОВЫХ ОКОН (Активные лоты, История и т.д.) ===== -->

    <!--#region СТИЛЬ СТРАНИЦЫ "АВТОРИЗАЦИЯ"-->

    <!-- Общие элементы страницы -->
    <Style x:Key="LogoStemAuthPage" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="GrayBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#32353c"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Картинки персонажей по бокам -->
    <Style x:Key="AuthSideImageLeft" TargetType="Image">
        <Setter Property="Width" Value="400"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Grid.RowSpan" Value="5"/>
    </Style>

    <Style x:Key="AuthSideImageRight" TargetType="Image" BasedOn="{StaticResource AuthSideImageLeft}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Тексты -->
    <Style x:Key="AuthHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#1999ff"/>
    </Style>

    <Style x:Key="AuthLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="FirstTimeStemTBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Поля ввода -->
    <Style x:Key="AuthTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="AuthPassBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="PasswordChar" Value="•"/>
    </Style>

    <!-- Кнопки -->
    <Style x:Key="EnterButton" TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="100,20,100,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#1999ff"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1078c9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FirstTimeStem" TargetType="Button">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="125"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#214b6b"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1999ff"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AuthLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- QR-код -->
    <Style x:Key="AuthQrCodeImage" TargetType="Image">
        <Setter Property="Margin" Value="0,20,20,20"/>
        <Setter Property="Width" Value="200"/>
    </Style>

    <!-- #endregion -->

    <!--#region СТИЛЬ СТРАНИЦЫ "МАРКЕТ"-->

    <!-- Общие фоны -->
    <Style x:Key="HeaderBG" TargetType="Border">
        <Setter Property="Background" Value="#171a21"/>
    </Style>
    <Style x:Key="MarketBG" TargetType="Border">
        <Setter Property="Background" Value="#577c22"/>
    </Style>

    <!-- Шапка (Header) -->
    <Style x:Key="LogoStemMarketPage" TargetType="Image">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="HeaderNavigations_StackPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="HeaderNavigations_Buttons" TargetType="Button">
        <Setter Property="Margin" Value="7"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#1999ff"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AccountAndExit" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="ExitBtn" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#214b6b"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1999ff"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="AccountTBox" TargetType="TextBlock">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="#1999ff"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,5,0,5"/>
    </Style>

    <!-- Верхняя плашка (Заголовок + Баланс) -->
    <Style x:Key="MainTittle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SubTittle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#85a45a"/>
    </Style>
    <Style x:Key="BalanceGrid" TargetType="Grid">
        <Setter Property="Background" Value="#101214"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="20,0,5,0"/>
    </Style>
    <Style x:Key="BalanceTBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0"/>
    </Style>

    <!-- Кнопки (Активные лоты, История, Продать) -->
    <Style x:Key="SometingGrid" TargetType="Grid">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="Margin" Value="0,30,0,5"/>
    </Style>
    <Style x:Key="SomethingStackPanel" TargetType="StackPanel">
        <Setter Property="Height" Value="39"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <Style x:Key="SomethingOneButton" TargetType="Button">
        <Setter Property="Margin" Value="0,0,15,0"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SomethingButtons" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="211"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Таблица предметов (Шапка и Список) -->
    <Style x:Key="MarketListHeader" TargetType="Grid">
        <Setter Property="Background" Value="#16202d"/>
        <Setter Property="Margin" Value="0,5,15,5"/>
    </Style>
    <Style x:Key="ItemNameTittle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>
    <Style x:Key="ItemCountAngPriceTittle" TargetType="TextBlock" BasedOn="{StaticResource ItemNameTittle}">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MainListBox" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,15,10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="OneListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="#16202d"/>
        <Setter Property="Foreground" Value="#66c0f4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="5,5,0,5"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1d2b3a"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MarketItemSubTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>

    <!-- Элементы внутри карточки товара -->
    <Style x:Key="ImageFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="#66c0f4"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ItemIco" TargetType="Image">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    <Style x:Key="ItemName" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#66c0f4"/>
    </Style>
    <Style x:Key="ItemCount" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StackPanelPrice" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>
    <Style x:Key="OtTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PriceTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!-- Сайдбар (Поиск, Фильтры, FAQ) -->
    <Style x:Key="SideBar" TargetType="StackPanel">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>
    <Style x:Key="SideBarBorder" TargetType="Border">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="Margin" Value="0,5,0,10"/>
        <Setter Property="Height" Value="350"/>
    </Style>
    <Style x:Key="SideBarStackPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <Style x:Key="SideBarInformationTop" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SideBarSearchTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#54a5d4"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>
    <Style x:Key="SideBarSearchTextBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="#3d4450"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SideBarSortTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#54a5d4"/>
        <Setter Property="Margin" Value="0,20,0,10"/>
    </Style>
    <Style x:Key="SideBarFilterTextBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#54a5d4"/>
        <Setter Property="Margin" Value="0,20,0,10"/>
    </Style>
    <Style x:Key="SideBarCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SideBarComboItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="#3d4450"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#577c22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FAQ" TargetType="Border">
        <Setter Property="Margin" Value="0,20,0,0"/>
        <Setter Property="Background" Value="#101822"/>
    </Style>
    <Style x:Key="SideBarInformationBottom" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ СТРАНИЦЫ "ПОКУПКА ПРЕДМЕТА"-->

    <!-- Основной контейнер -->
    <Style x:Key="BuyPageContainer" TargetType="Border">
        <Setter Property="Background" Value="#16202d"/>
    </Style>

    <!-- Хедер -->
    <Style x:Key="BuyPageHeader" TargetType="Grid">
        <Setter Property="Background" Value="#171a21"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="BuyPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BuyPageCloseButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Margin" Value="10,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Блок с картинкой и информацией -->
    <Style x:Key="BuyPageImageBorder" TargetType="Border">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="#3d4450"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,20,0"/>
    </Style>
    <Style x:Key="BuyPageItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#66c0f4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="BuyPageItemDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>
    <Style x:Key="BuyPageInfoBorder" TargetType="Border">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="Padding" Value="15"/>
    </Style>
    <Style x:Key="BuyPageInfoText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="BuyPageSellerText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Margin" Value="0,15,0,0"/>
    </Style>

    <!-- Подвал (цена и кнопки) -->
    <Style x:Key="BuyPageFooter" TargetType="Border">
        <Setter Property="Background" Value="#171a21"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="BuyPagePrice" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#577c22"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Кнопки изменения количества -->
    <Style x:Key="BuyPageCountButton" TargetType="Button">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="BuyPageMinusButton" TargetType="Button" BasedOn="{StaticResource BuyPageCountButton}">
        <Setter Property="Background" Value="#2a3f5a"/>
    </Style>
    <Style x:Key="BuyPagePlusButton" TargetType="Button" BasedOn="{StaticResource BuyPageCountButton}">
        <Setter Property="Background" Value="#577c22"/>
    </Style>

    <!-- Текст количества -->
    <Style x:Key="BuyPageCountBorder" TargetType="Border">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="5,0"/>
    </Style>
    <Style x:Key="BuyPageCountText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Кнопка "Купить" -->
    <Style x:Key="BuyPageBuyButton" TargetType="Button">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#6c9b2a"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ СТРАНИЦЫ "ИНВЕНТАРЬ"-->

    <!-- Плашка профиля (сверху) -->
    <Style x:Key="InventoryProfilePanel" TargetType="Grid">
        <Setter Property="Background" Value="#2a3340"/>
    </Style>
    <Style x:Key="InventoryAvatarBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#6a6a6a"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="25,0,25,0"/>
    </Style>
    <Style x:Key="InventoryProfileName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InventoryBreadcrumb" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
    </Style>

    <!-- Основной контент (рамка и фон) -->
    <Style x:Key="InventoryMainBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#6a6a6a"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="20"/>
    </Style>
    <Style x:Key="InventoryMainGrid" TargetType="Grid">
        <Setter Property="Background" Value="#1c1f21"/>
    </Style>

    <!-- Фильтры и поиск -->
    <Style x:Key="InventoryFilterLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>
    <Style x:Key="InventorySearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Background" Value="#16191a"/>
        <Setter Property="BorderBrush" Value="Black"/>
    </Style>

    <!-- Сетка инвентаря (UniformGrid и ячейки) -->
    <Style x:Key="InventoryListBox" TargetType="ListBox">
        <Setter Property="Width" Value="538"/>
        <Setter Property="Height" Value="538"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="InventoryUniformGrid" TargetType="UniformGrid">
        <Setter Property="Columns" Value="5"/>
        <Setter Property="Rows" Value="5"/>
        <Setter Property="Background" Value="Black"/>
    </Style>
    <Style x:Key="InventoryCellBorder" TargetType="Border">
        <Setter Property="Background" Value="#454545"/>
        <Setter Property="BorderBrush" Value="#66c0f4"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="InventoryCellImage" TargetType="Image">
        <Setter Property="Width" Value="95"/>
        <Setter Property="Height" Value="95"/>
    </Style>

    <!-- Пагинация -->
    <Style x:Key="InventoryPageButton" TargetType="Button">
        <Setter Property="Width" Value="35"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="InventoryPageText" TargetType="TextBlock">
