        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="BuyDialogSummaryValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BuyDialogSummaryFinal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Блок оплаты -->
    <Style x:Key="BuyDialogPaymentLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>
    <Style x:Key="BuyDialogPaymentValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>
    <Style x:Key="BuyDialogPaymentValueGreen" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#577c22"/>
    </Style>

    <!-- Чекбокс и кнопка -->
    <Style x:Key="BuyDialogAgreement" TargetType="CheckBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,15,0,0"/>
    </Style>
    <Style x:Key="BuyDialogButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="75"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

</ResourceDictionary>