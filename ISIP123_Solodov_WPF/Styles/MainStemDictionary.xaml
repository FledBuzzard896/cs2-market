<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ===== СТРАНИЦА ВХОДА В STEM ===== -->
    <!-- Стиль кнопок при первом входе в Stem -->
    <Style x:Key="FirstTimeStem" TargetType="Button">
        <Setter Property="Height" Value="25"/>
        <Setter Property="Width" Value="125"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#214b6b"/>
    </Style>
    <Style x:Key="EnterButton" TargetType="Button">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Margin" Value="100,20,100,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#1999ff"/>
    </Style>
    
    <!-- Стиль полей для ввода при авторизации/регистрации -->
    <Style x:Key="AuthTextBox" TargetType="TextBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="AuthPassBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="400"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="PasswordChar" Value="•"/>
    </Style>
    
    <!-- Стиль границы области информации о входе -->
    <Style x:Key="GrayBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="#32353c"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- Стиль плашки "Первый раз в Stem?" -->
    <Style x:Key="FirstTimeStemTBlock" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <!-- Стиль лого Stem на странице авторизации/регистрации -->
    <Style x:Key="LogoStemAuthPage" TargetType="Image">
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    
    
    
    <!-- ===== СТРАНИЦА МАРКЕТА ===== -->
    <!-- Стиль заднего фона -->
    <Style x:Key="HeaderBG" TargetType="Border">
        <Setter Property="Background" Value="#171a21"/>
    </Style>
    <Style x:Key="MarketBG" TargetType="Border">
        <Setter Property="Background" Value="#577c22"/>
    </Style>
    
    <!-- Стиль логотипа Stem на странице ТП -->
    <Style x:Key="LogoStemMarketPage" TargetType="Image">
        <Setter Property="Width" Value="175"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    
    <!-- Стиль StackPanel с кнопками в Header -->
    <Style x:Key="HeaderNavigations_StackPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="HeaderNavigations_Buttons" TargetType="Button">
        <Setter Property="Margin" Value="7"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    
    <!-- Стиль StackPanel с Аккаунтом -->
    <Style x:Key="AccountAndExit" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="ExitBtn" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#214b6b"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="AccountTBox" TargetType="TextBlock">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="#1999ff"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,5,0,5"/>
    </Style>
    
    <!-- Стиль зеленой плашки "Торговая площадка" -->
    <Style x:Key="MainTittle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SubTittle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#85a45a"/>
    </Style>
    
    <!-- Стиль плашки баланса кошелька -->
    <Style x:Key="BalanceGrid" TargetType="Grid">
        <Setter Property="Background" Value="#101214"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="20,0,5,0"/>
    </Style>
    <Style x:Key="BalanceTBlock" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5,0"/>
    </Style>
    
    <!-- Плашка "Активные лоты" + "История сделок" -->
    <Style x:Key="SometingGrid" TargetType="Grid">
        <Setter Property="Background" Value="#101822"/>
        <Setter Property="Margin" Value="0,30,0,5"/>
    </Style>
    <Style x:Key="SomethingStackPanel" TargetType="StackPanel">
        <Setter Property="Height" Value="39"/>
        <Setter Property="Orientation" Value="Horizontal"/>
    </Style>
    <Style x:Key="SomethingOneButton" TargetType="Button">
        <Setter Property="Margin" Value="0,0,15,0"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="SomethingButtons" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="211"/>
        <Setter Property="Height" Value="39"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
</ResourceDictionary>