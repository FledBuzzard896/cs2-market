        <Setter Property="Foreground" Value="#D2D2D2"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InventoryCardStatText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#666666"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style x:Key="InventoryCardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#D2D2D2"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="InventoryCardBottomBar" TargetType="Grid">
        <Setter Property="Background" Value="#141a21"/>
    </Style>
    <Style x:Key="InventoryCardPriceText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#D2D2D2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <Style x:Key="InventoryCardSellButton" TargetType="Button">
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="75"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="10,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!-- ===== СТИЛИ ДЛЯ ДИАЛОГОВЫХ ОКОН (Активные лоты, История и т.д.) ===== -->

    <!--#region СТИЛЬ ДИАЛОГА "АКТИВНЫЕ ЛОТЫ"-->
    <!-- Фон диалогового окна -->
    <SolidColorBrush x:Key="DialogBackground" Color="#181a21"/>

    <!-- Заголовки таблицы -->
    <Style x:Key="DialogHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogHeaderTextCenter" TargetType="TextBlock" BasedOn="{StaticResource DialogHeaderText}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Стили для списка -->
    <Style x:Key="DialogListBox" TargetType="ListBox">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    </Style>

    <Style x:Key="DialogListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" 
                            Padding="{TemplateBinding Padding}" 
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogRowBorder" TargetType="Border">
        <Setter Property="Background" Value="#16202d"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <Style x:Key="DialogItemTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#66c0f4"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogItemText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DialogItemPrice" TargetType="TextBlock" BasedOn="{StaticResource DialogItemText}">
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="DialogActionButton" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#66c0f4"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ОШИБКА"-->
    <Style x:Key="ErrorLogo" TargetType="Image">
        <Setter Property="Width" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="ErrorTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ErrorSubtitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="ErrorCloseButton" TargetType="Button">
        <Setter Property="Background" Value="#214b6b"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1999ff"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ИСТОРИЯ СДЕЛОК"-->
    <!-- Знак операции (+ или -) -->
    <Style x:Key="DialogOperationSign" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#577c22"/>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ВОССТАНОВЛЕНИЕ ПАРОЛЯ"-->
    <!-- Заголовок окна -->
    <Style x:Key="SupportTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Темная плашка контента -->
    <Style x:Key="SupportContentBorder" TargetType="Border">
        <Setter Property="Background" Value="#0c1827"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Синий заголовок внутри формы -->
    <Style x:Key="SupportHeaderText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#1999ff"/>
    </Style>

    <!-- Подписи к полям ввода -->
    <Style x:Key="SupportInputLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- Поля ввода (TextBox) -->
    <Style x:Key="SupportInputBox" TargetType="TextBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Поля ввода (PasswordBox) -->
    <Style x:Key="SupportPasswordBox" TargetType="PasswordBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Синие кнопки (Назад, Сменить) -->
    <Style x:Key="SupportActionButton" TargetType="Button">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#1999ff"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1078c9"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ПОДТВЕРЖДЕНИЕ ЗАКРЫТИЯ"-->
    <!-- Специфичный фон для этого окна -->
    <SolidColorBrush x:Key="LastQuestionBackground" Color="#262626"/>

    <Style x:Key="LastQuestionLogo" TargetType="Image">
        <Setter Property="Width" Value="100"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="LastQuestionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Кнопки "Да" и "Нет" -->
    <Style x:Key="LastQuestionButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="75"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Background" Value="#5076a3"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#3d5d82"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ПРОФИЛЬ"-->
    <!-- Текст подписей (Логин, Никнейм, Баланс) -->
    <Style x:Key="ProfileLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Текст значений (справа) -->
    <Style x:Key="ProfileValueText" TargetType="TextBlock" BasedOn="{StaticResource ProfileLabelText}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Кнопка "Пополнить" -->
    <Style x:Key="ProfileActionButton" TargetType="Button">
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#1999ff"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1078c9"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "РЕГИСТРАЦИЯ"-->
    <!-- Заголовок окна -->
    <Style x:Key="RegistrationTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Подписи к полям -->
    <Style x:Key="RegistrationLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>

    <!-- Поля ввода (TextBox) -->
    <Style x:Key="RegistrationTextBox" TargetType="TextBox">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Поля паролей (PasswordBox) -->
    <Style x:Key="RegistrationPasswordBox" TargetType="PasswordBox">
        <Setter Property="Width" Value="200"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#32353c"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="PasswordChar" Value="•"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Кнопки "Назад" и "Создать" -->
    <Style x:Key="RegistrationButton" TargetType="Button">
        <Setter Property="Width" Value="75"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#1999ff"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1078c9"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ВЫСТАВЛЕНИЕ НА ПРОДАЖУ"-->
    <!-- Заголовок окна -->
    <Style x:Key="SellDialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Название предмета в шапке -->
    <Style x:Key="SellDialogItemName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#1999ff"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- Разделительная линия -->
    <Style x:Key="DialogSeparator" TargetType="Separator">
        <Setter Property="Background" Value="#afb1b8"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <!-- Текст с ценами (Средняя, Последняя) -->
    <Style x:Key="SellDialogPriceText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#afb1b8"/>
    </Style>

    <!-- Кнопки "+" и "-" -->
    <Style x:Key="CountButton" TargetType="Button">
        <Setter Property="Width" Value="20"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Текст количества -->
    <Style x:Key="CountText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#afb1b8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="15,0,15,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Предупреждение о невозможности продажи нескольких штук -->
    <Style x:Key="WarningText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="DarkRed"/>
        <Setter Property="Margin" Value="20,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Подписи к полям цен (Вы получите / Покупатель заплатит) -->
    <Style x:Key="PriceInputLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Текстовые поля для ввода цен -->
    <Style x:Key="PriceInputBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#171717"/>
        <Setter Property="BorderBrush" Value="Black"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Чекбокс соглашения -->
    <Style x:Key="AgreementCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Главная зеленая кнопка подтверждения -->
    <Style x:Key="GreenActionButton" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#577c22"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#6c9b2a"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- #endregion -->

    <!--#region СТИЛЬ ДИАЛОГА "ПОКУПКА ПРЕДМЕТОВ"-->
    <!-- Заголовок окна -->
    <Style x:Key="BuyDialogTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
