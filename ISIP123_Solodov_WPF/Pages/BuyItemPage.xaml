<Page x:Class="ISIP123_Solodov_WPF.Pages.BuyItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="BuyItemPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Images/background-1.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Grid Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="900"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Основной контейнер карточки товара -->
                <Border Grid.Column="1" Style="{StaticResource BuyPageContainer}">
                    <Grid x:Name="ItemGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. ХЕДЕР СТРАНИЦЫ -->
                        <Grid Grid.Row="0" Style="{StaticResource BuyPageHeader}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="/Images/stem-logo-nobg.png" Margin="10" Style="{StaticResource LogoStemMarketPage}" Grid.Column="0"/>
                            <TextBlock Text="ПОКУПКА ПРЕДМЕТА" Style="{StaticResource BuyPageTitle}" Grid.Column="1"/>
                            <Button x:Name="CloseBtn" Content="✖ Закрыть" Style="{StaticResource BuyPageCloseButton}" Click="CloseBtn_Click" Grid.Column="2"/>
                        </Grid>

                        <!-- 2. ОСНОВНОЙ КОНТЕНТ -->
                        <Grid Grid.Row="1" Margin="20,0,20,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть: Картинка -->
                            <Border Style="{StaticResource BuyPageImageBorder}">
                                <Image Source="{Binding InventoryItems.Items.ItemPicture}" Stretch="Uniform"/>
                            </Border>

                            <!-- Правая часть: Информация -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <TextBlock Text="{Binding InventoryItems.Items.Name}" Style="{StaticResource BuyPageItemTitle}"/>
                                <TextBlock Text="{Binding InventoryItems.Items.Description}" Style="{StaticResource BuyPageItemDescription}"/>

                                <Border Style="{StaticResource BuyPageInfoBorder}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding InventoryItems.Items.ItemTypes.Name, StringFormat={}Тип: {0}}" Style="{StaticResource BuyPageInfoText}"/>
                                        <TextBlock Text="{Binding InventoryItems.Items.Qualities.Name, StringFormat={}Качество: {0}}" Style="{StaticResource BuyPageInfoText}"/>

                                        <!-- Износ скрывается, если это не скин -->
                                        <TextBlock Text="{Binding InventoryItems.FloatValue, StringFormat={}Износ: {0}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BuyPageInfoText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InventoryItems.FloatValue}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock x:Name="Sostoianie" Style="{StaticResource BuyPageInfoText}" Margin="0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Users.Nickname, StringFormat={}Продавец: {0}}" Style="{StaticResource BuyPageSellerText}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. ПОДВАЛ (Цена и Кнопки) -->
                        <Border Grid.Row="2" Style="{StaticResource BuyPageFooter}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="Price" Text="Загрузка..." Style="{StaticResource BuyPagePrice}"/>

                                    <!-- Панель количества -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="Minus" Content="–" Style="{StaticResource BuyPageMinusButton}" Click="Minus_Click"/>

                                        <Border Style="{StaticResource BuyPageCountBorder}">
                                            <TextBlock x:Name="CountOfSkin" Text="1" Style="{StaticResource BuyPageCountText}"/>
                                        </Border>

                                        <Button x:Name="Plus" Content="+" Style="{StaticResource BuyPagePlusButton}" Click="Plus_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Кнопка Купить -->
                                <Button x:Name="BuyButton" Grid.Column="1" Content="Купить" Style="{StaticResource BuyPageBuyButton}" Click="BuyButton_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
