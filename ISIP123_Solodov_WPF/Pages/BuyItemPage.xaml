<Page x:Class="ISIP123_Solodov_WPF.Pages.BuyItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="BuyItemPage">
    <Grid x:Name="ItemGrid">
        <Grid.Background>
            <ImageBrush ImageSource="/Images/background-1.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.ColumnSpan="3" Grid.Row="0" Background="#171a21"/>
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="10" Background="#101822" Margin="0,0,0,25"/>

        <Image Source="/Images/stem-logo-nobg.png" Margin="10" Style="{StaticResource LogoStemMarketPage}"/>
        <TextBlock Text="ПОКУПКА ПРЕДМЕТА" FontSize="34" Foreground="White" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Border Style="{StaticResource ImageFrame}" BorderThickness="2" Background="#3d4450" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="1">
            <Image Source="{Binding Inventories.Items.ItemPicture}" Width="300" Margin="10"/>
        </Border>
        <TextBlock Text="{Binding Inventories.Items.Name, StringFormat={}НАЗВАНИЕ: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="2" Margin="10,10,0,0"/>
        <TextBlock Text="{Binding Inventories.Items.Description, StringFormat={}ОПИСАНИЕ: {0}}" FontSize="16" TextWrapping="Wrap" Foreground="#afb1b8" Grid.Column="1" Grid.Row="3" Margin="10,5,0,0"/>
        <TextBlock x:Name="Sostoianie" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="4" Margin="10,10,0,0"/>
        <TextBlock Text="{Binding Inventories.Items.Types.Name, StringFormat={}ТИП: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="5" Margin="10,5,0,0"/>
        <TextBlock Text="{Binding Inventories.Items.Qualities.Name, StringFormat={}КАЧЕСТВО: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="6" Margin="10,5,0,0"/>
        <TextBlock Text="{Binding Inventories.Flot, StringFormat={}СТЕПЕНЬ ИЗНОСА: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="7" Margin="10,5,0,0"/>
        <TextBlock x:Name="Price" FontSize="16" Foreground="#577c22" Grid.Column="1" Grid.Row="8" Margin="10,15,0,0"/>
    </Grid>
</Page>
