<Page x:Class="ISIP123_Solodov_WPF.Pages.BuyItemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="BuyItemPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid x:Name="ItemGrid">
            <Grid.Background>
                <ImageBrush ImageSource="/Images/background-1.png" Stretch="UniformToFill"/>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="3" Grid.Row="0" Background="#171a21"/>
            <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="9" Background="#101822"/>

            <Button x:Name="CloseBtn" Background="Transparent" Content="Зыкрыть" Margin="25" Height="20" Width="75" BorderThickness="0" Foreground="#afb1b8" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="2" Click="CloseBtn_Click"/>
            <Image Source="/Images/stem-logo-nobg.png" Margin="10" Style="{StaticResource LogoStemMarketPage}"/>
            <TextBlock Text="ПОКУПКА ПРЕДМЕТА" FontSize="34" Foreground="White" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Border Style="{StaticResource ImageFrame}" BorderThickness="2" Background="#3d4450" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="1">
                <Image Source="{Binding Inventories.Items.ItemPicture}" Width="300" Margin="10"/>
            </Border>

            <TextBlock Text="{Binding Inventories.Items.Name, StringFormat={}НАЗВАНИЕ: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="2" Margin="10,10,0,0"/>
            <TextBlock Text="{Binding Inventories.Items.Description, StringFormat={}ОПИСАНИЕ: {0}}" FontSize="16" TextWrapping="Wrap" Foreground="#afb1b8" Grid.Column="1" Grid.Row="3" Margin="10,3,10,0"/>
            <TextBlock x:Name="Sostoianie" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="4" Margin="10,10,0,0"/>
            <TextBlock Text="{Binding Inventories.Items.Types.Name, StringFormat={}ТИП: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="5" Margin="10,3,0,0"/>
            <TextBlock Text="{Binding Inventories.Items.Qualities.Name, StringFormat={}КАЧЕСТВО: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="6" Margin="10,3,0,0"/>
            <TextBlock Text="{Binding Inventories.Flot, StringFormat={}СТЕПЕНЬ ИЗНОСА: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="7" Margin="10,3,0,0"/>
            <TextBlock x:Name="Price" Text="тест" FontSize="16" Foreground="#577c22" Grid.Column="1" Grid.Row="8" Margin="10,15,0,0"/>
            <TextBlock Text="{Binding Users1.Nickname, StringFormat={}Продавец: {0}}" FontSize="16" Foreground="#afb1b8" Grid.Column="1" Grid.Row="9" Margin="10,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="10" Grid.Column="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <Button x:Name="Minus" Content="–" FontSize="16" FontWeight="Bold" Foreground="White" BorderThickness="0" Background="DarkRed" Width="25" Height="25" Click="Minus_Click"/>
                    <TextBlock x:Name="CountOfSkin" Text="1" FontSize="16" FontWeight="Bold" Foreground="White" Height="25" Margin="10,0,10,0"/>
                    <Button x:Name="Plus" Content="+" FontSize="16" FontWeight="Bold" Foreground="White" BorderThickness="0" Background="#577c22" Width="25" Height="25" Click="Plus_Click"/>
                </StackPanel>
                <Button x:Name="BuyButton" Content="Купить" Width="100" Height="25" FontSize="16" BorderThickness="0" VerticalContentAlignment="Center" Background="#577c22" Foreground="White" Click="BuyButton_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
