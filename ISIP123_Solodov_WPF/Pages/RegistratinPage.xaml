<Page x:Class="ISIP123_Solodov_WPF.Pages.RegistratinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistratinPage">

    <Grid Background="#181a21">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Images/stem-logo-nobg.png" Style="{StaticResource LogoStemAuthPage}" Grid.Row="0"/>
        <TextBlock Text="СОЗДАНИЕ АККАУНТА" Foreground="White" FontSize="24" Margin="0,0,0,30" Grid.Row="1" Grid.Column="1"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,30">
            <TextBlock Text="Логин" Foreground="#afb1b8"/>
            <TextBox x:Name="NewUserLoginTB" Width="200" Height="30" BorderThickness="0" Background="#32353c" Foreground="White" VerticalContentAlignment="Center" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,30">
            <TextBlock Text="Пароль" Foreground="#afb1b8"/>
            <PasswordBox x:Name="NewUserPasswordF" Width="200" Height="30" BorderThickness="0" Background="#32353c" Foreground="White" VerticalContentAlignment="Center" PasswordChar="•" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,30">
            <TextBlock Text="Повторите пароль" Foreground="#afb1b8"/>
            <PasswordBox x:Name="NewUserPasswordS" Width="200" Height="30" BorderThickness="0" Background="#32353c" Foreground="White" VerticalContentAlignment="Center" PasswordChar="•" HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1">
            <Button x:Name="BackBtn" Content="Назад" Width="75" Height="20" BorderThickness="0" Background="#1999ff" Foreground="White" Margin="0,0,50,0" Click="BackBtn_Click"/>
            <Button x:Name="RegBtn" Content="Создать" Width="75" Height="20" BorderThickness="0" Background="#1999ff" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
