<Page x:Class="ISIP123_Solodov_WPF.Pages.Market"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="500" d:MinWidth="1100"
      Title="Market">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- header -->
        <Grid Grid.Row="0" Background="#171a21">
            <Image Source="/Images/stem-logo-nobg.png" Width="75" Height="30" HorizontalAlignment="Left" Margin="10,5,5,5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="exitBtn"
                        Content="Выйти"
                        Width="50" Height="20"
                        Foreground="White" Background="#214b6b"
                        BorderThickness="0"/>
                <TextBlock x:Name="NicknameTBox"
                           Text="тест"
                           Width="100" Height="20"
                           Foreground="#1999ff" Background="#32353c"
                           TextAlignment="Center"
                           Margin="5"/>
            </StackPanel>
        </Grid>
        
        <!-- Что такое ТП + кошелёк -->
        <Grid Grid.Row="1" Background="#577c22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1010"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Левая часть -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Торговая площадка" FontSize="20" Foreground="White" Grid.Row="0"/>
                    <TextBlock Text="Продавайте и покупайте предметы участников сообщества Stem." Foreground="#85a45a" Grid.Row="1"/>
                </Grid>
                
                <!-- Правая часть -->
                <Grid Grid.Column="1" Background="#101214" Margin="20,0,0,0">
                    <TextBlock Text="Баланс кошелька ... " Foreground="White" VerticalAlignment="Center" Margin="5,0,5,0"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Background="#1b2838">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1010"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="1" Grid.Row="0" Height="25" Margin="0,10,0,5" Orientation="Horizontal" Background="#101822">
                <Button x:Name="listingsBtn" Content="Активные лоты" Width="125" BorderThickness="0" Background="#577c22" Foreground="White" Margin="0,0,10,0" Click="listingsBtn_Click"/>
                <Button x:Name="historyBtn" Content="История сделок" Width="125" BorderThickness="0" Background="#577c22" Foreground="White" Click="historyBtn_Click"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Предметы -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Background="#16202d" Margin="0,5,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="600"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                    
                        <TextBlock Text="НАЗВАНИЕ" Grid.Column="0" Foreground="#afb1b8" Margin="5,0,0,0"/>
                        <TextBlock Text="КОЛ-ВО" Grid.Column="1" TextAlignment="Center" Foreground="#afb1b8"/>
                        <TextBlock Text="ЦЕНА" Grid.Column="2" TextAlignment="Center" Foreground="#afb1b8"/>
                    </Grid>

                    <ListBox x:Name="ItemsLB"
                             Grid.Row="1" Grid.Column="0"
                             BorderThickness="0"
                             Margin="0,0,0,10"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="#16202d"/>
                                <!-- Растягиваем элемент по всей ширине ListBox -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="5,5,0,5"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="600"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Border BorderBrush="#66c0f4" BorderThickness="1">
                                            <Image Source="{Binding Inventories.Items.ItemPicture}" Width="64" Height="64" Grid.Column="0" Margin="5"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" Grid.Column="1" Orientation="Vertical">
                                            <TextBlock Text="{Binding Inventories.Items.Name}" FontWeight="Bold" Foreground="#afb1b8"/>
                                            <TextBlock Text="Counter-Strike 2" Foreground="#afb1b8"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Inventories.Count}" Foreground="#afb1b8" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Grid.Column="2">
                                        <TextBlock Text="От" Foreground="#afb1b8" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" Foreground="White" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
