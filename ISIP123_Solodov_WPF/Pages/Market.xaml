<Page x:Class="ISIP123_Solodov_WPF.Pages.Market"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="Market">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Images/background-1.png" Stretch="UniformToFill"/>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="121"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="949"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Покраска -->
            <Border Style="{StaticResource HeaderBG}" 
                    Grid.Row="0" Grid.ColumnSpan="3"/>
            <Border Style="{StaticResource MarketBG}"
                    Grid.Row="1" Grid.ColumnSpan="3"/>

            <!-- Header -->
            <Grid Grid.Row="0" Grid.Column="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Лого -->
                <Image Source="/Images/stem-logo-nobg.png"
                       Style="{StaticResource LogoStemMarketPage}"
                       Grid.Column="0"/>
                
                <!-- Кнопки -->
                <StackPanel Grid.Column="1" Style="{StaticResource HeaderNavigations_StackPanel}" >
                    <Button x:Name="shopBtn" Content="МАГАЗИН"
                            Style="{StaticResource HeaderNavigations_Buttons}" 
                            Click="ShowError_Dialog"/>
                    <Button x:Name="communityBtn" Content="СООБЩЕСТВО" 
                            Style="{StaticResource HeaderNavigations_Buttons}" 
                            Foreground="#1999ff"
                            Click="communityBtn_Click"/>
                    <Button x:Name="informationBtn" Content="ИНФОРМАЦИЯ" 
                            Style="{StaticResource HeaderNavigations_Buttons}" 
                            Click="ShowError_Dialog"/>
                    <Button x:Name="supportBtn" Content="ПОДДЕРЖКА" 
                            Style="{StaticResource HeaderNavigations_Buttons}" 
                            Click="ShowError_Dialog"/>
                </StackPanel>
                
                <!-- Аккаунт + Кнопка Выйти -->
                <StackPanel Style="{StaticResource AccountAndExit}" Grid.Column="2">
                    <Button x:Name="exitBtn"
                            Content="Выйти"
                            Style="{StaticResource ExitBtn}"
                            Click="exitBtn_Click"/>
                    <TextBlock x:Name="NicknameTBox"
                               Text="тест"
                               Style="{StaticResource AccountTBox}"/>
                </StackPanel>
            </Grid>

            <!-- Что такое ТП + кошелёк -->
            <Grid Grid.Row="1" Grid.Column="1">

                <Grid Grid.Column="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая часть -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Торговая площадка" FontSize="34" Foreground="White" VerticalAlignment="Center" Grid.Row="0"/>
                        <TextBlock Text="Продавайте и покупайте предметы участников сообщества Stem." FontSize="14" Foreground="#85a45a" Grid.Row="1"/>
                    </StackPanel>

                    <!-- Правая часть -->
                    <Grid Grid.Column="1" Background="#101214" Height="50" Margin="20,0,5,0">
                        <TextBlock x:Name="balance" Text="Баланс кошелька ... " FontSize="16"  Foreground="White" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Активные лоты + История сделок -->
                <Grid Grid.Row="0" Background="#101822" Margin="0,30,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Height="39"  Orientation="Horizontal">
                        <Button x:Name="listingsBtn" Content="Активные лоты" FontSize="14" Width="211" Height="39" BorderThickness="0" Background="#577c22" Foreground="White" Margin="0,0,10,0" Click="listingsBtn_Click"/>
                        <Button x:Name="historyBtn" Content="История сделок" FontSize="14" Width="211" Height="39" BorderThickness="0" Background="#577c22" Foreground="White" Click="historyBtn_Click"/>
                    </StackPanel>

                    <Button x:Name="sellItemBtn" Content="Продать предмет" Grid.Column="1" Margin="0,0,15,0" Width="120" Height="24" Background="#577c22" Foreground="White" BorderThickness="0" Click="sellItemBtn_Click"/>
                </Grid>


                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="654"/>
                        <ColumnDefinition Width="295"/>
                    </Grid.ColumnDefinitions>

                    <!-- Предметы -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Background="#16202d" Margin="0,5,15,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="455"/>
                                <ColumnDefinition Width="81"/>
                                <ColumnDefinition Width="94"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="НАЗВАНИЕ" Grid.Column="0"  VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#afb1b8"/>
                            <TextBlock Text="КОЛ-ВО" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" Foreground="#afb1b8"/>
                            <TextBlock Text="ЦЕНА" Grid.Column="2" TextAlignment="Center" VerticalAlignment="Center" Foreground="#afb1b8"/>
                        </Grid>

                        <ListBox x:Name="ItemsLB"
                            Grid.Row="1"
                            BorderThickness="0"
                            Margin="0,0,15,10"
                            Background="Transparent"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="ListBox_PreviewMouseWheel">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="#16202d"/>
                                    <Setter Property="Foreground" Value="#66c0f4"/>
                                    <!-- Растягиваем элемент по всей ширине ListBox -->
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="5,5,0,5"/>
                                    <Setter Property="Margin" Value="0,0,0,5"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="455"/>
                                            <ColumnDefinition Width="81"/>
                                            <ColumnDefinition Width="94"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <Border x:Name="ImageFrame" BorderBrush="#66c0f4" BorderThickness="1">
                                                <Image Source="{Binding Inventories.Items.ItemPicture}" Width="64" Height="64" Grid.Column="0" Margin="5"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" Grid.Column="1" Orientation="Vertical">
                                                <TextBlock x:Name="ItemName" Text="{Binding Inventories.Items.Name}" Foreground="#66c0f4" FontWeight="Bold"/>
                                                <TextBlock Text="Counter-Strike 2" Foreground="#afb1b8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Inventories.Count}" Foreground="#afb1b8" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Grid.Column="2">
                                            <TextBlock Text="От" Foreground="#afb1b8" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Price, StringFormat={}{0} руб.}" Foreground="White" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Vertical">
                        <Border Background="#101822" Margin="0,5,0,10" Height="350">
                            <StackPanel  Orientation="Vertical" Margin="10">
                                <TextBlock Text="Прочтите требования к безопасности для использования Торговой площадки" Foreground="#afb1b8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="Поиск предметов" Foreground="#54a5d4" Margin="0,10,0,10"/>
                                <TextBox x:Name="searchTBox"  BorderThickness="0" Height="30" Background="#3d4450" Foreground="White" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Сортировать по" Foreground="#54a5d4" Margin="0,20,0,10"/>
                                <ComboBox Height="30" BorderThickness="0" VerticalContentAlignment="Center">
                                    <ComboBox.Resources>
                                        <!-- Красим пункты выпадашки -->
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#3d4450"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#577c22"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Название (↑)"/>
                                    <ComboBoxItem Content="Название (↓)"/>
                                    <ComboBoxItem Content="Цена (↑)"/>
                                    <ComboBoxItem Content="Цена (↓)"/>
                                </ComboBox>
                                <TextBlock Text="Фильтры" Foreground="#54a5d4" Margin="0,20,0,10"/>
                                <ComboBox x:Name="TypesCombo" Height="30" BorderThickness="0" VerticalContentAlignment="Center">
                                    <ComboBox.Resources>
                                        <!-- Красим пункты выпадашки -->
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#3d4450"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#577c22"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                                <ComboBox x:Name="QualitesCombo" Height="30" BorderThickness="0" VerticalContentAlignment="Center" Margin="0,10,0,0">
                                    <ComboBox.Resources>
                                        <!-- Красим пункты выпадашки -->
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#3d4450"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#577c22"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,20,0,0" Background="#101822">
                            <StackPanel Orientation="Vertical" Margin="10">
                                <TextBlock FontSize="14" Foreground="#afb1b8" TextWrapping="Wrap">
                                    <Hyperlink NavigateUri="https://help.steampowered.com/ru/faqs/view/61F0-72B7-9A18-C70B" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#afb1b8">
                                        Частые вопросы
                                    </Hyperlink>
                                    о Торговой площадке
                                </TextBlock>
                                <TextBlock FontSize="14" Foreground="#afb1b8" TextWrapping="Wrap" Margin="0,15,0,0">
                                    Вступайте в 
                                    <Hyperlink NavigateUri="https://steamcommunity.com/groups/community_market" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#afb1b8">
                                        группу Торговой площадки
                                    </Hyperlink>
                                    для обсуждений и официальных объявлений
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
