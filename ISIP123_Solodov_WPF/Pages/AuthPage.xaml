<Page x:Class="ISIP123_Solodov_WPF.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="AuthPage">

    <Grid Background="{StaticResource DialogBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Image Source="/Images/stem-logo-nobg.png"
           Style="{StaticResource LogoStemAuthPage}"
           Grid.Row="0"/>

        <Image Source="/Images/Koishi.png" Style="{StaticResource AuthSideImageLeft}"/>
        <Image Source="/Images/Raphtalia.png" Style="{StaticResource AuthSideImageRight}"/>

        <Border Style="{StaticResource GrayBorder}" Grid.Row="1">
            <Grid Background="{StaticResource DialogBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="20">
                    <TextBlock Text="ВОЙДИТЕ, ИСПОЛЬЗУЯ ИМЯ АККАУНТА" Style="{StaticResource AuthHeaderText}"/>
                    <TextBox x:Name="loginBox" Style="{StaticResource AuthTextBox}"/>

                    <TextBlock Text="ПАРОЛЬ" Style="{StaticResource AuthLabelText}"/>
                    <PasswordBox x:Name="passwordBox" Style="{StaticResource AuthPassBox}"/>

                    <Button x:Name="enterBtn" 
                    Content="Войти"
                    Style="{StaticResource EnterButton}"
                    Click="enterBtn_Click"/>

                    <Button x:Name="IForgotPassword"
                        Content="Помогите, я не могу войти в аккаунт" 
                        Style="{StaticResource AuthLinkButton}"
                        Click="IForgotPassword_Click"/>
                </StackPanel>

                <Image Grid.Column="1" Source="/Images/steam-wiki-qr.jpg" Style="{StaticResource AuthQrCodeImage}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="20" HorizontalAlignment="Center">
            <TextBlock Text="Первый раз в Stem?" Style="{StaticResource FirstTimeStemTBlock}"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="regBtn"
                    Content="Создать аккаунт"
                    Style="{StaticResource FirstTimeStem}"
                    Margin="0,0,20,0" 
                    Click="regBtn_Click"/>
                <Button x:Name="entryGuestBtn"
                    Content="Войти без аккаунта"
                    Style="{StaticResource FirstTimeStem}"
                    Click="entryGuestBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
