<Page x:Class="ISIP123_Solodov_WPF.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid Background="#181a21">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <Image Source="/Images/stem-logo-nobg.png"
               Style="{StaticResource LogoStemAuthPage}"
               Grid.Row="0"/>

        <Border Style="{StaticResource GrayBorder}" Grid.Row="1">
            <Grid Background="#181a21" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="20">
                    <TextBlock Text="ВОЙДИТЕ, ИСПОЛЬЗУЯ ИМЯ АККАУНТА" Foreground="#1999ff"/>
                    <TextBox x:Name="loginBox" Style="{StaticResource AuthTextBox}"/>
                    <TextBlock Text="ПАРОЛЬ" Foreground="#afb1b8" Margin="0,10,0,0"/>
                    <PasswordBox x:Name="passwordBox" Style="{StaticResource AuthPassBox}"/>

                    <Button x:Name="enterBtn" 
                        Content="Войти"
                        Style="{StaticResource EnterButton}"
                        Click="enterBtn_Click"/>

                    <Button x:Name="IForgotPassword"
                            Content="Помогите, я не могу войти в аккаунт" 
                            Foreground="#afb1b8" Background="Transparent"
                            BorderThickness="0" Margin="5"
                            Click="IForgotPassword_Click"/>
                </StackPanel>
                <Image Grid.Column="1" Margin="0,20,20,20" Width="200" Source="/Images/steam-wiki-qr.jpg"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="20" HorizontalAlignment="Center">
            <TextBlock Text="Первый раз в Stem?" Style="{StaticResource FirstTimeStemTBlock}"/>
            
            <StackPanel Orientation="Horizontal">
                <Button x:Name="regBtn"
                        Content="Создать аккаунт"
                        Style="{StaticResource FirstTimeStem}"
                        Margin="0,0,20,0" 
                        Click="regBtn_Click"/>
                <Button x:Name="entryGuestBtn"
                        Content="Войти без аккаунта"
                        Style="{StaticResource FirstTimeStem}"
                        Click="entryGuestBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
