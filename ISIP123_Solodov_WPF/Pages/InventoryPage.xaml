<Page x:Class="ISIP123_Solodov_WPF.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ISIP123_Solodov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1500"
      d:MinHeight="550" d:MinWidth="1100"
      Title="InventoryPage">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="949"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="104"/>
                <RowDefinition Height="121"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.Background>
                <ImageBrush ImageSource="/Images/background-1.png" Stretch="UniformToFill"/>
            </Grid.Background>

            <Border Style="{StaticResource HeaderBG}" 
                Grid.Row="0" Grid.ColumnSpan="3"/>

            <Grid Grid.Row="0" Grid.Column="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Image Source="/Images/stem-logo-nobg.png"
                   Style="{StaticResource LogoStemMarketPage}"
                   Grid.Column="0"/>

                <StackPanel Grid.Column="1" Style="{StaticResource HeaderNavigations_StackPanel}" >
                    <Button x:Name="shopBtn" Content="МАГАЗИН"
                        Style="{StaticResource HeaderNavigations_Buttons}" 
                        Click="ShowError_Dialog"/>
                    <Button x:Name="communityBtn" Content="МАРКЕТ" 
                        Style="{StaticResource HeaderNavigations_Buttons}" 
                        Foreground="#1999ff"
                        Click="MarketBtn_Click"/>
                    <Button x:Name="informationBtn" Content="ИНФОРМАЦИЯ" 
                        Style="{StaticResource HeaderNavigations_Buttons}" 
                        Click="ShowError_Dialog"/>
                    <Button x:Name="supportBtn" Content="ПОДДЕРЖКА" 
                        Style="{StaticResource HeaderNavigations_Buttons}" 
                        Click="ShowError_Dialog"/>
                </StackPanel>

                <StackPanel Style="{StaticResource AccountAndExit}" Grid.Column="2">
                    <Button x:Name="exitBtn" Content="Выйти" Style="{StaticResource ExitBtn}" Click="exitBtn_Click"/>
                    <TextBlock x:Name="NicknameTBlock" Text="тест" Style="{StaticResource AccountTBox}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Background="#2a3340">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="25,0,25,0" BorderBrush="#6a6a6a" BorderThickness="2" VerticalAlignment="Center">
                    <Image Source="/Images/steam-smile.png" Height="68" Width="68"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="NicknameTBlock_2" FontSize="26" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text=">> Инвентарь" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <Border Grid.Row="2" Grid.Column="1" BorderBrush="#6a6a6a" BorderThickness="1" Margin="20">
                <Grid Background="#1c1f21">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Source="/Images/CS2 logo.png" Width="250" HorizontalAlignment="Left" Margin="5,5,0,0" Grid.Row="0"/>
                    <Grid Grid.Row="1" Margin="5,0,5,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Поиск по предметам:" FontSize="14" Foreground="#afb1b8" Grid.Column="0"/>
                        <TextBox x:Name="SearchItemTBox" FontSize="14" Foreground="#afb1b8" Background="#16191a" BorderBrush="Black" Margin="10,0,0,0" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="5,0,5,5" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тип:" FontSize="14" Foreground="#afb1b8" Grid.Column="0"/>
                        <ComboBox x:Name="TypesCombo" Style="{StaticResource SideBarCombo}" ItemContainerStyle="{StaticResource SideBarComboItem}" Margin="10,0,0,0" Height="20" Width="150" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="5,0,5,5" Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Редкость:" FontSize="14" Foreground="#afb1b8" Grid.Column="0"/>
                        <ComboBox x:Name="QualitesCombo" Style="{StaticResource SideBarCombo}" ItemContainerStyle="{StaticResource SideBarComboItem}" Margin="10,0,0,0" Height="20" Width="150" Grid.Column="1"/>
                    </Grid>
                    <Grid Grid.Row="4" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="InventoryItems" Grid.Row="0" Grid.Column="0" Width="538" Height="538" VerticalAlignment="Top" HorizontalAlignment="Left" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ListBox_PreviewMouseWheel">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" Rows="5" Background="Black"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ImageFrame}" Background="#454545">
                                        <Image Source="{Binding ItemPicture}" Width="95" Height="95"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
